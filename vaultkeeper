#!/bin/bash
# vaultkeeper - Unified CLI for VaultKeeper development
# Usage: ./vaultkeeper [dev|deploy|start|stop|logs|status]

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PID_DIR="$SCRIPT_DIR/.pids"
LOG_DIR="$SCRIPT_DIR/.logs"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Create directories
mkdir -p "$PID_DIR" "$LOG_DIR"

# Helper functions
log_info() { echo -e "${BLUE}[INFO]${NC} $1"; }
log_success() { echo -e "${GREEN}[OK]${NC} $1"; }
log_warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
log_error() { echo -e "${RED}[ERROR]${NC} $1"; }

check_anvil() {
    curl -s -X POST -H "Content-Type: application/json" \
        -d '{"jsonrpc":"2.0","method":"eth_blockNumber","params":[],"id":1}' \
        http://127.0.0.1:8545 > /dev/null 2>&1
}

# Commands
cmd_dev() {
    log_info "Starting VaultKeeper development environment..."
    
    # Check if already running
    if [ -f "$PID_DIR/anvil.pid" ] && kill -0 "$(cat "$PID_DIR/anvil.pid")" 2>/dev/null; then
        log_warn "Anvil is already running"
    else
        # Start Anvil
        log_info "Starting Anvil on port 8545..."
        cd "$SCRIPT_DIR/contracts"
        anvil > "$LOG_DIR/anvil.log" 2>&1 &
        echo $! > "$PID_DIR/anvil.pid"
        
        # Wait for Anvil to start
        log_info "Waiting for Anvil to start..."
        for i in {1..30}; do
            if check_anvil; then
                log_success "Anvil is ready"
                break
            fi
            sleep 1
        done
        
        if ! check_anvil; then
            log_error "Anvil failed to start. Check $LOG_DIR/anvil.log"
            exit 1
        fi
    fi
    
    # Deploy contracts if needed
    if [ "${1:-}" = "--deploy" ] || [ ! -f "$SCRIPT_DIR/contracts/broadcast/Deploy.s.sol/31337/run-latest.json" ]; then
        log_info "Deploying contracts..."
        cd "$SCRIPT_DIR/contracts"
        forge script script/Deploy.s.sol \
            --rpc-url http://localhost:8545 \
            --private-key 0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80 \
            --broadcast > "$LOG_DIR/deploy.log" 2>&1
        
        if [ $? -eq 0 ]; then
            log_success "Contracts deployed"
        else
            log_error "Deployment failed. Check $LOG_DIR/deploy.log"
            exit 1
        fi
    else
        log_info "Contracts already deployed (use --deploy to redeploy)"
    fi
    
    # Start frontend
    if [ -f "$PID_DIR/frontend.pid" ] && kill -0 "$(cat "$PID_DIR/frontend.pid")" 2>/dev/null; then
        log_warn "Frontend is already running on http://localhost:3000"
    else
        log_info "Starting frontend on http://localhost:3000..."
        cd "$SCRIPT_DIR/web"
        npm run dev > "$LOG_DIR/frontend.log" 2>&1 &
        echo $! > "$PID_DIR/frontend.pid"
        log_success "Frontend started"
    fi
    
    echo ""
    log_success "🚀 VaultKeeper is running!"
    echo "  • Anvil:      http://127.0.0.1:8545"
    echo "  • Frontend:   http://localhost:3000"
    echo "  • Dashboard:  http://localhost:3000/dashboard"
    echo "  • Strategy:   http://localhost:3000/dashboard/strategy"
    echo ""
    log_info "Commands:"
    echo "  ./vaultkeeper logs    - View all logs"
    echo "  ./vaultkeeper stop    - Stop all services"
    echo "  ./vaultkeeper status  - Check service status"
}

cmd_deploy() {
    log_info "Deploying contracts..."
    
    if ! check_anvil; then
        log_error "Anvil is not running. Start it first with: ./vaultkeeper dev"
        exit 1
    fi
    
    cd "$SCRIPT_DIR/contracts"
    forge script script/Deploy.s.sol \
        --rpc-url http://localhost:8545 \
        --private-key 0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80 \
        --broadcast
    
    if [ $? -eq 0 ]; then
        log_success "Contracts deployed successfully"
    else
        log_error "Deployment failed"
        exit 1
    fi
}

cmd_stop() {
    log_info "Stopping VaultKeeper services..."
    
    # Stop frontend
    if [ -f "$PID_DIR/frontend.pid" ]; then
        PID=$(cat "$PID_DIR/frontend.pid")
        if kill -0 "$PID" 2>/dev/null; then
            kill "$PID" 2>/dev/null
            log_success "Frontend stopped"
        fi
        rm -f "$PID_DIR/frontend.pid"
    fi
    
    # Stop Anvil
    if [ -f "$PID_DIR/anvil.pid" ]; then
        PID=$(cat "$PID_DIR/anvil.pid")
        if kill -0 "$PID" 2>/dev/null; then
            kill "$PID" 2>/dev/null
            log_success "Anvil stopped"
        fi
        rm -f "$PID_DIR/anvil.pid"
    fi
    
    log_success "All services stopped"
}

cmd_logs() {
    if [ "${1:-}" = "anvil" ]; then
        tail -f "$LOG_DIR/anvil.log"
    elif [ "${1:-}" = "frontend" ]; then
        tail -f "$LOG_DIR/frontend.log"
    elif [ "${1:-}" = "deploy" ]; then
        tail -f "$LOG_DIR/deploy.log"
    else
        echo "Watching all logs (Ctrl+C to exit)..."
        tail -f "$LOG_DIR"/*.log 2>/dev/null || log_warn "No logs found"
    fi
}

cmd_status() {
    echo "VaultKeeper Status:"
    echo ""
    
    # Anvil status
    if [ -f "$PID_DIR/anvil.pid" ] && kill -0 "$(cat "$PID_DIR/anvil.pid")" 2>/dev/null; then
        if check_anvil; then
            log_success "Anvil:     Running ✓ (PID: $(cat "$PID_DIR/anvil.pid"))"
        else
            log_warn "Anvil:     Process running but not responding"
        fi
    else
        log_error "Anvil:     Stopped ✗"
    fi
    
    # Frontend status
    if [ -f "$PID_DIR/frontend.pid" ] && kill -0 "$(cat "$PID_DIR/frontend.pid")" 2>/dev/null; then
        log_success "Frontend:  Running ✓ (PID: $(cat "$PID_DIR/frontend.pid"), http://localhost:3000)"
    else
        log_error "Frontend:  Stopped ✗"
    fi
    
    echo ""
    echo "Logs: $LOG_DIR"
    echo "PIDs: $PID_DIR"
}

cmd_help() {
    echo "VaultKeeper CLI"
    echo ""
    echo "Usage: ./vaultkeeper [command] [options]"
    echo ""
    echo "Commands:"
    echo "  dev [ --deploy ]   Start development environment (Anvil + Frontend)"
    echo "  deploy             Deploy contracts to local Anvil"
    echo "  stop               Stop all services"
    echo "  logs [service]     View logs (anvil|frontend|deploy)"
    echo "  status             Check service status"
    echo "  help               Show this help"
    echo ""
    echo "Examples:"
    echo "  ./vaultkeeper dev           # Start with existing contracts"
    echo "  ./vaultkeeper dev --deploy  # Start and deploy contracts"
    echo "  ./vaultkeeper logs anvil    # Watch Anvil logs"
    echo "  ./vaultkeeper stop          # Stop everything"
}

# Main
case "${1:-help}" in
    dev)
        cmd_dev "${2:-}"
        ;;
    deploy)
        cmd_deploy
        ;;
    stop)
        cmd_stop
        ;;
    logs)
        cmd_logs "${2:-}"
        ;;
    status)
        cmd_status
        ;;
    help|--help|-h)
        cmd_help
        ;;
    *)
        log_error "Unknown command: $1"
        cmd_help
        exit 1
        ;;
esac

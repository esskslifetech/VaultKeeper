# Copy to contracts/.env (git-ignored) or export these in your shell before deploying.
#
# REQUIRED by script/Deploy.s.sol — the deployer key. Never commit a real key.
PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# OPTIONAL — RPC endpoint for `forge script --rpc-url "$RPC_URL" --broadcast`.
RPC_URL=http://127.0.0.1:8545

# OPTIONAL — where the deployment manifest is written. Defaults to
# deployments/<chainId>.json, relative to the contracts/ directory.
# MANIFEST_PATH=deployments/31337.json
